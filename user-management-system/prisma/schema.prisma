generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  mongoId   String   @unique
  name      String
  email     String   @unique
  role      String
  isActive  Boolean  @default(true)
  createdAt DateTime
  updatedAt DateTime
}